<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Adeka Academy Hub</title>
<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:linear-gradient(135deg,#04152d,#062a54,#0d3f7a);
min-height:100vh;
color:white;
padding:20px;
}

.container{
max-width:1000px;
margin:auto;
}

.logo{
width:180px;
border-radius:20px;
display:block;
margin:auto;
margin-bottom:20px;
}

.header{
text-align:center;
margin-bottom:30px;
}

.header h1{
font-size:2.5rem;
text-shadow:0 2px 14px rgba(255,215,0,.4);
}

.header p{
color:#ffd700;
}

.card{
background:rgba(255,255,255,.1);
backdrop-filter:blur(10px);
padding:25px;
border-radius:20px;
margin-bottom:25px;
border:1px solid rgba(255,255,255,.15);
box-shadow:0 8px 24px rgba(0,0,0,.25);
}

input{
width:100%;
padding:15px;
margin:10px 0;
border:none;
border-radius:10px;
font-size:16px;
}

button{
width:100%;
padding:15px;
margin-top:10px;
border:none;
border-radius:10px;
background:#ffd700;
font-weight:bold;
font-size:16px;
cursor:pointer;
}

button:hover{opacity:.9;}

.hidden{display:none;}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-top:20px;
}

.box{
background:rgba(255,255,255,.1);
padding:25px;
border-radius:15px;
text-align:center;
border:1px solid rgba(255,255,255,.15);
cursor:pointer;
transition:transform .2s, box-shadow .2s, background .2s;
}

.box:hover{
transform:translateY(-4px);
background:rgba(255,255,255,.18);
box-shadow:0 10px 24px rgba(0,0,0,.35);
}

.box h3{margin-top:10px;margin-bottom:10px;}

.about{line-height:1.8;}

#menuOverlay{
position:fixed;
top:0;left:0;right:0;bottom:0;
background:rgba(0,0,0,.45);
z-index:998;
display:none;
}

#sideMenu{
position:fixed;
top:0;
left:-260px;
width:250px;
height:100%;
background:#062a54;
padding:20px;
z-index:999;
overflow:auto;
transition:0.3s;
}

#sideMenu.show{left:0;}

#sideMenu button{margin-bottom:10px;}

footer{
text-align:center;
margin-top:40px;
padding:20px;
border-top:1px solid rgba(255,255,255,.2);
}

.lightTheme{background:white;color:black;}

.lightTheme .card,
.lightTheme .box{background:#f0f0f0;color:black;}

.lightTheme .header p{color:#b8860b;}

body.text-small{font-size:14px;}
body.text-normal{font-size:16px;}
body.text-large{font-size:19px;}

.btn-secondary{
background:rgba(255,255,255,.15) !important;
color:white !important;
border:1px solid rgba(255,255,255,.3) !important;
}

.lightTheme .btn-secondary{
background:rgba(0,0,0,.08) !important;
color:black !important;
border:1px solid rgba(0,0,0,.2) !important;
}

.btn-danger{
background:#ff5c5c !important;
color:white !important;
}

.switch{
position:relative;
display:inline-block;
width:56px;
height:30px;
margin:10px 0;
}

.switch input{opacity:0;width:0;height:0;}

.slider{
position:absolute;
cursor:pointer;
top:0;left:0;right:0;bottom:0;
background-color:rgba(255,255,255,.25);
border-radius:30px;
transition:.3s;
}

.slider:before{
position:absolute;
content:"";
height:24px;
width:24px;
left:3px;
bottom:3px;
background-color:white;
border-radius:50%;
transition:.3s;
}

input:checked + .slider{background-color:#ffd700;}
input:checked + .slider:before{transform:translateX(26px);}

.chat-msg{margin-bottom:12px;}

.chat-msg .sender{color:#ffd700;font-weight:bold;}

.lightTheme .chat-msg .sender{color:#b8860b;}

.chat-msg .time{
opacity:.6;
font-size:11px;
margin-left:6px;
}

#chatPanel{
position:fixed;
top:0;
right:-360px;
width:340px;
max-width:90vw;
height:100%;
background:rgba(6,42,84,.97);
border-left:1px solid rgba(255,255,255,.2);
box-shadow:-8px 0 30px rgba(0,0,0,.5);
z-index:1200;
display:flex;
flex-direction:column;
overflow:hidden;
transition:right .3s ease;
}

#chatPanel.show{right:0;}

#chatBubble{
position:fixed;
bottom:20px;
right:20px;
width:60px;
height:60px;
border-radius:50%;
font-size:26px;
z-index:1000;
box-shadow:0 4px 14px rgba(0,0,0,.45);
padding:0;
margin:0;
}

#floatingBack{
position:fixed;
top:20px;
left:20px;
width:auto;
padding:10px 20px;
z-index:1000;
border-radius:30px;
box-shadow:0 4px 14px rgba(0,0,0,.45);
}

#floatingLogout{
position:fixed;
top:20px;
right:20px;
width:auto;
padding:10px 20px;
z-index:1000;
border-radius:30px;
box-shadow:0 4px 14px rgba(0,0,0,.45);
background:#ff5c5c !important;
color:white !important;
border:none;
font-weight:bold;
font-size:15px;
cursor:pointer;
}

#floatingLogout:hover{opacity:.9;}

.callContainer{
width:100%;
height:480px;
border-radius:15px;
overflow:hidden;
margin-top:15px;
background:#000;
}

/* Profile image lightbox */
#picLightbox{
position:fixed;
top:0;left:0;right:0;bottom:0;
background:rgba(0,0,0,.88);
z-index:9999;
display:flex;
align-items:center;
justify-content:center;
flex-direction:column;
gap:16px;
}

#picLightbox img{
max-width:90vw;
max-height:80vh;
border-radius:16px;
border:3px solid #ffd700;
box-shadow:0 0 40px rgba(255,215,0,.3);
object-fit:contain;
}

#picLightbox button{width:auto;padding:10px 30px;}

/* Toast notifications */
#toastContainer{
position:fixed;
bottom:90px;
left:50%;
transform:translateX(-50%);
z-index:9998;
display:flex;
flex-direction:column;
align-items:center;
gap:8px;
pointer-events:none;
}

.toast{
background:rgba(10,40,80,.96);
border:1px solid rgba(255,215,0,.4);
border-radius:12px;
padding:12px 22px;
font-size:15px;
font-weight:bold;
color:white;
box-shadow:0 4px 18px rgba(0,0,0,.4);
animation:toastIn .3s ease, toastOut .3s ease 2.7s forwards;
max-width:80vw;
text-align:center;
}

.toast.success{border-color:#00c864;color:#00e87a;}
.toast.error{border-color:#ff5c5c;color:#ff7c7c;}
.toast.info{border-color:#ffd700;color:#ffd700;}

@keyframes toastIn{
from{opacity:0;transform:translateY(12px);}
to{opacity:1;transform:translateY(0);}
}

@keyframes toastOut{
from{opacity:1;}
to{opacity:0;}
}

/* Quiz styles */
.quiz-level-btn{
padding:20px;
margin:10px 0;
font-size:18px;
border-radius:15px;
background:rgba(255,255,255,.12);
border:1px solid rgba(255,255,255,.2);
color:white;
cursor:pointer;
transition:background .2s, transform .2s;
}

.quiz-level-btn:hover{
background:rgba(255,215,0,.25);
transform:translateY(-2px);
}

.quiz-subject-btn{
padding:14px;
margin:6px 0;
font-size:15px;
border-radius:12px;
background:rgba(255,255,255,.1);
border:1px solid rgba(255,255,255,.15);
color:white;
cursor:pointer;
transition:background .2s;
display:flex;
justify-content:space-between;
align-items:center;
}

.quiz-subject-btn:hover{background:rgba(255,215,0,.2);}

.quiz-option{
padding:14px 18px;
margin:8px 0;
border-radius:12px;
background:rgba(255,255,255,.1);
border:1px solid rgba(255,255,255,.2);
cursor:pointer;
font-size:15px;
transition:background .2s;
text-align:left;
color:white;
}

.quiz-option:hover{background:rgba(255,215,0,.2);}

.quiz-option.correct{
background:rgba(0,200,100,.35) !important;
border-color:#00c864 !important;
}

.quiz-option.wrong{
background:rgba(255,60,60,.35) !important;
border-color:#ff3c3c !important;
}

.quiz-progress{
background:rgba(255,255,255,.1);
border-radius:10px;
height:8px;
margin:10px 0 20px;
overflow:hidden;
}

.quiz-progress-bar{
height:100%;
background:#ffd700;
border-radius:10px;
transition:width .3s;
}

/* Timer */
.quiz-timer-wrap{
display:flex;
align-items:center;
justify-content:center;
margin-bottom:10px;
}

.quiz-timer{
width:52px;
height:52px;
border-radius:50%;
border:4px solid #ffd700;
display:flex;
align-items:center;
justify-content:center;
font-size:20px;
font-weight:bold;
transition:border-color .3s, color .3s;
color:white;
}

.quiz-timer.urgent{
border-color:#ff5c5c;
color:#ff5c5c;
animation:pulse .5s infinite alternate;
}

@keyframes pulse{
from{transform:scale(1);}
to{transform:scale(1.12);}
}

/* Streak badge */
.streak-badge{
display:inline-block;
background:linear-gradient(135deg,#ff6a00,#ffd700);
border-radius:20px;
padding:4px 14px;
font-size:13px;
font-weight:bold;
color:#062a54;
margin-left:8px;
vertical-align:middle;
}

.leaderboard-row{
display:flex;
justify-content:space-between;
align-items:center;
background:rgba(255,255,255,.08);
border-radius:10px;
padding:10px 14px;
margin:6px 0;
}

.leaderboard-row.top1{background:rgba(255,215,0,.2);}
.leaderboard-row.top2{background:rgba(192,192,192,.15);}
.leaderboard-row.top3{background:rgba(205,127,50,.15);}

/* Task done style */
.task-done{
text-decoration:line-through;
opacity:.5;
}

/* Welcome greeting */
#welcomeGreeting{
color:#ffd700;
font-size:1rem;
margin-top:6px;
font-weight:bold;
}

/* Daily streak */
#streakDisplay{
display:inline-flex;
align-items:center;
gap:8px;
background:linear-gradient(135deg,rgba(255,106,0,.25),rgba(255,215,0,.2));
border:1px solid rgba(255,150,0,.4);
border-radius:20px;
padding:6px 16px;
margin-top:10px;
font-weight:bold;
font-size:15px;
}

#streakDisplay.cold{
background:rgba(255,255,255,.08);
border-color:rgba(255,255,255,.15);
}

.lightTheme .quiz-level-btn,
.lightTheme .quiz-subject-btn,
.lightTheme .quiz-option,
.lightTheme .leaderboard-row{
color:black;
background:rgba(0,0,0,.06);
border-color:rgba(0,0,0,.15);
}

.lightTheme .quiz-timer{color:#062a54;border-color:#062a54;}
.lightTheme .quiz-timer.urgent{color:#cc0000;border-color:#cc0000;}
</style>
</head>
<body>
<div id="toastContainer"></div>
<div id="menuOverlay" onclick="closeMenu()"></div>
<div class="container">

<button id="floatingBack" class="hidden" onclick="backToDashboard()">← Back</button>
<button id="floatingLogout" class="hidden" onclick="logout()">Logout</button>
<button id="chatBubble" class="hidden" onclick="toggleChatPanel()">💬</button>

<!-- Profile picture lightbox -->
<div id="picLightbox" class="hidden" onclick="closeLightbox()">
  <img id="lightboxImg" src="" alt="Profile Picture">
  <button class="btn-secondary" onclick="closeLightbox()">✕ Close</button>
</div>

<div id="chatPanel">
  <div style="padding:12px 15px;border-bottom:1px solid rgba(255,255,255,.15);display:flex;justify-content:space-between;align-items:center;">
    <strong>💬 Class Chat</strong>
    <div style="display:flex;gap:6px;">
    <button class="btn-danger" onclick="clearChatHistory()" style="width:auto;padding:4px 10px;margin:0;font-size:14px;" title="Clear chat for everyone">🗑️</button>
    <button class="btn-secondary" onclick="toggleChatPanel()" style="width:auto;padding:4px 10px;margin:0;font-size:16px;">✕</button>
    </div>
  </div>
  <div id="chatMessages" style="flex:1;overflow-y:auto;padding:10px 15px;font-size:14px;color:white;"></div>
  <div style="display:flex;padding:10px;border-top:1px solid rgba(255,255,255,.15);gap:8px;">
    <input id="chatInput" placeholder="Type a message..." style="margin:0;flex:1;" onkeyup="if(event.key==='Enter') sendChatMessage();">
    <button onclick="sendChatMessage()" style="width:auto;margin:0;padding:10px 16px;">Send</button>
  </div>
</div>

<img src="logo.png" class="logo" alt="Adeka Academy Hub Logo">
<div class="header">
    <h1>Adeka Academy Hub</h1>
    <p>Learn • Connect • Grow</p>
    <p id="message" style="color:#00ff88;font-weight:bold;margin-top:10px;"></p>
</div>

<div class="card" id="auth">
<h2>Welcome</h2>
<br>
<input type="text" id="fullName" placeholder="Full Name">
<input type="email" id="email" placeholder="Email Address">
<input type="password" id="password" placeholder="Password">
<label>
<input type="checkbox" id="rememberMe">
Remember Me
</label>
<button onclick="register()">Create Account</button>
<button onclick="login()">Login</button>
<button class="btn-secondary" onclick="resetPassword()">Forgot Password?</button>
</div>

<div id="dashboard" class="hidden">

<div id="profileSection" class="card hidden">
<h2>My Profile</h2>
<p><strong>Name:</strong> <span id="profileName"></span></p>
<p><strong>Email:</strong> <span id="profileEmail"></span></p>
<br>
<input type="file" id="profilePic" accept="image/*" style="display:none;" onchange="saveProfilePicture(event)">
<div style="text-align:center;">
  <img
    id="profileImage"
    src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' fill='%23ffd700'/><circle cx='60' cy='46' r='22' fill='%23062a54'/><path d='M16 112 Q60 74 104 112 Z' fill='%23062a54'/></svg>"
    style="width:120px;height:120px;border-radius:50%;margin:0 auto 8px;display:block;border:3px solid #ffd700;box-shadow:0 4px 16px rgba(0,0,0,.45);object-fit:cover;cursor:pointer;"
    title="Tap to view full size"
    onclick="openLightbox()"
  >
  <p style="font-size:12px;opacity:.6;margin-bottom:6px;">Tap to view full size</p>
  <button class="btn-secondary" style="width:auto;padding:8px 18px;font-size:14px;" onclick="document.getElementById('profilePic').click()">📷 Change Photo</button>
</div>
</div>

<div id="sideMenu">
<button onclick="openProgress()">📊 Progress</button>
<button onclick="openTasks()">✅ Study Tasks</button>
<button onclick="openBadges()">🏆 Achievements</button>
<button onclick="openSettings()">⚙️ Settings</button>
<button class="btn-secondary" onclick="closeMenu()">❌ Close</button>
</div>

<div class="card" id="dashboardHome">
<h2>Dashboard</h2>
<div id="welcomeGreeting"></div>
<div id="streakDisplay" class="cold">🔥 Streak: <span id="streakCount">0</span> day(s)</div>
<br>
<button class="btn-secondary" onclick="toggleMenu()" style="width:auto;padding:10px 15px;margin-top:12px;">☰ Menu</button>
<p id="currentDate" style="margin-top:8px;opacity:.75;font-size:14px;"></p>

<div class="grid">
<div class="box" onclick="openAITutor()">
📚
<h3>AI Tutor</h3>
<p>Powered by Adeka AI</p>
</div>
<div class="box" onclick="openMeetingCenter()">
🎥
<h3>Meeting Center</h3>
<p>Join classes and meetings</p>
</div>
<div class="box" onclick="openNotes()">
📝
<h3>Notes</h3>
<p>Create and save notes</p>

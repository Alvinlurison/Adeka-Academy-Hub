// =============================================
// TOAST NOTIFICATIONS
// =============================================
function showToast(msg, type="info", duration=3000){
  const container = document.getElementById("toastContainer");
  const toast = document.createElement("div");
  toast.className = "toast " + type;
  toast.innerText = msg;
  container.appendChild(toast);
  setTimeout(() => { toast.remove(); }, duration);
}

// =============================================
// WELCOME GREETING
// =============================================
function setWelcomeGreeting(){
  const name = localStorage.getItem("studentName");
  if(!name) return;
  const hour = new Date().getHours();
  const time = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
  const firstName = name.split(" ")[0];
  document.getElementById("welcomeGreeting").innerText = time + ", " + firstName + " 👋";
}

// =============================================
// DAILY STUDY STREAK
// =============================================
function checkDailyStreak(){
  const today = new Date().toDateString();
  const lastVisit = localStorage.getItem("lastVisitDate");
  let streak = parseInt(localStorage.getItem("studyStreak") || "0");

  if(lastVisit === today){
    // already logged in today, just show streak
  } else if(lastVisit){
    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);
    if(lastVisit === yesterday.toDateString()){
      streak++;
      showToast("🔥 Day " + streak + " streak! Keep it up!", "success");
    } else {
      streak = 1;
      if(localStorage.getItem("studyStreak") > 1){
        showToast("Streak reset. Start fresh today! 💪", "info");
      }
    }
    localStorage.setItem("lastVisitDate", today);
    localStorage.setItem("studyStreak", streak);
  } else {
    streak = 1;
    localStorage.setItem("lastVisitDate", today);
    localStorage.setItem("studyStreak", "1");
  }

  updateStreakUI(streak);

  // Milestone badges
  if(streak >= 3 && !localStorage.getItem("streak3Badge")){
    localStorage.setItem("streak3Badge","earned");
    playBadgeSound();
    showToast("🏅 3-Day Streak badge earned!","success");
  }
  if(streak >= 7 && !localStorage.getItem("streak7Badge")){
    localStorage.setItem("streak7Badge","earned");
    playBadgeSound();
    showToast("⭐ 7-Day Streak badge earned!","success");
  }
  if(streak >= 30 && !localStorage.getItem("streak30Badge")){
    localStorage.setItem("streak30Badge","earned");
    playBadgeSound();
    showToast("👑 30-Day Streak badge earned!","success");
  }
}

function updateStreakUI(streak){
  const el = document.getElementById("streakDisplay");
  document.getElementById("streakCount").innerText = streak;
  if(streak >= 3){
    el.classList.remove("cold");
  } else {
    el.classList.add("cold");
  }
}


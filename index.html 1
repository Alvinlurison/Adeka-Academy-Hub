}

async function login(){
  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value;
  try{
    const userCredential = await window.signInWithEmailAndPassword(window.auth, email, password);
    const user = userCredential.user;
    const docSnap = await window.getDoc(window.doc(window.db,"user",user.uid));
    if(docSnap.exists()){
      const data = docSnap.data();
      document.getElementById("profileName").innerText = data.fullName;
      document.getElementById("profileEmail").innerText = data.email;
      localStorage.setItem("studentName", data.fullName);
      localStorage.setItem("studentEmail", data.email);
      if(document.getElementById("rememberMe").checked){
        localStorage.setItem("rememberedEmail", email);
      }else{
        localStorage.removeItem("rememberedEmail");
      }
    }
    document.getElementById("auth").style.display = "none";
    document.getElementById("dashboard").classList.remove("hidden");
    document.getElementById("profileSection").classList.remove("hidden");
    document.getElementById("dashboardHome").classList.remove("hidden");
    showChatBubble();
    showFloatingLogout();
    startChatListener();
    setWelcomeGreeting();
    checkDailyStreak();
    const savedPic = localStorage.getItem("profilePicture");
    if(savedPic){
      document.getElementById("profileImage").src = savedPic;
      document.getElementById("profileStatus").innerText = "Yes";
      localStorage.setItem("profileBadge","earned");
    }
    window.scrollTo({ top:0, behavior:"smooth" });
    showToast("Login successful! 👋", "success");
  }catch(error){ showToast(error.message,"error",5000); }
}

async function logout(){
  try{
    stopQuizTimer();
    await window.signOut(window.auth);
    localStorage.removeItem("studentName");
    localStorage.removeItem("studentEmail");
    document.getElementById("fullName").value="";
    document.getElementById("email").value="";
    document.getElementById("password").value="";
    document.getElementById("profileName").innerText="";
    document.getElementById("profileEmail").innerText="";
    document.getElementById("welcomeGreeting").innerText="";
    document.getElementById("dashboard").classList.add("hidden");
    document.getElementById("profileSection").classList.add("hidden");
    document.getElementById("auth").style.display="block";
    hideAllSections();
    hideBackButton();
    hideFloatingLogout();
    leaveMeeting();
    leaveAudioRoom();
    hideChatBubble();
    stopChatListener();
    showToast("Logged out. See you soon!", "info");
  }catch(error){ showToast(error.message,"error"); }
}


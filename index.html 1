let currentLevel=null, currentSubject=null, currentQuestions=[];
let currentQuestionIndex=0, currentScore=0, currentStreak=0, answered=false;
let quizTimerInterval=null, timeLeft=15;
const QUIZ_TIME_PER_Q = 15;

function stopQuizTimer(){
  if(quizTimerInterval){ clearInterval(quizTimerInterval); quizTimerInterval=null; }
}

function startQuizTimer(){
  stopQuizTimer();
  timeLeft = QUIZ_TIME_PER_Q;
  const el = document.getElementById("quizTimer");
  el.classList.remove("urgent");
  el.innerText = timeLeft;
  quizTimerInterval = setInterval(()=>{
    timeLeft--;
    el.innerText = timeLeft;
    if(timeLeft <= 5) el.classList.add("urgent");
    if(timeLeft <= 0){
      stopQuizTimer();
      if(!answered) timeOut();
    }
  }, 1000);
}

function timeOut(){
  answered = true;
  const q = currentQuestions[currentQuestionIndex];
  document.querySelectorAll(".quiz-option").forEach(b=>b.style.pointerEvents="none");
  document.getElementById(`opt-${q.a}`).classList.add("correct");
  document.getElementById("quizFeedback").innerText = "⏰ Time's up! The answer was: " + q.o[q.a];
  document.getElementById("quizFeedback").style.color = "#ffd700";
  currentStreak = 0;
  updateStreakDisplay();
  document.getElementById("quizNextBtn").classList.remove("hidden");
}


  const data = QUIZ_DATA[level];
  document.getElementById("quizLevelLabel").innerText = data.label + " — Choose a Subject";
  const subjects = Object.keys(data.subjects);
  let html="";
  subjects.forEach(subject=>{
    const bestKey = "quizBest_"+level+"_"+subject;
    const best = localStorage.getItem(bestKey);
    const bestLabel = best ? `<span style="font-size:12px;opacity:.6;">Best: ${best}%</span>` : `<span style="font-size:12px;opacity:.4;">No record yet</span>`;
    html += `<button class="quiz-subject-btn" onclick="selectSubject('${subject}')">${subject} ${bestLabel}</button>`;
  });
  document.getElementById("quizSubjectList").innerHTML = html;
  showQuizStep("quizSubjectPicker");
}

function backToLevelPicker(){
  stopQuizTimer();
  currentLevel=null; currentSubject=null;
  showQuizStep("quizLevelPicker");
}

function selectSubject(subject){
  currentSubject = subject;
  const allQs = QUIZ_DATA[currentLevel].subjects[subject];
  currentQuestions = [...allQs].sort(()=>Math.random()-.5).slice(0,10);
  currentQuestionIndex=0; currentScore=0; currentStreak=0; answered=false;
  document.getElementById("quizSubjectLabel").innerText = subject;
  document.getElementById("quizScoreDisplay").innerText = "Score: 0";
  showQuizStep("quizGame");
  renderQuestion();
}

function updateStreakDisplay(){
  const el = document.getElementById("quizStreakDisplay");
  if(currentStreak >= 2){
    el.innerHTML = `<span class="streak-badge">🔥 ${currentStreak} streak</span>`;
  }else{
    el.innerHTML="";
  }
}

function renderQuestion(){
  const q = currentQuestions[currentQuestionIndex];
  const total = currentQuestions.length;
  document.getElementById("quizQNum").innerText = `Question ${currentQuestionIndex+1} of ${total}`;
  document.getElementById("quizProgressBar").style.width = ((currentQuestionIndex/total)*100)+"%";
  document.getElementById("quizQuestion").innerText = q.q;
  document.getElementById("quizFeedback").innerText="";
  document.getElementById("quizNextBtn").classList.add("hidden");
  answered=false;
  updateStreakDisplay();

  let html="";
  q.o.forEach((opt,idx)=>{
    html += `<button class="quiz-option" id="opt-${idx}" onclick="selectAnswer(${idx})">${opt}</button>`;
  });
  document.getElementById("quizOptions").innerHTML = html;
  startQuizTimer();
}

function selectAnswer(idx){
  if(answered) return;
  answered=true;
  stopQuizTimer();
  const q = currentQuestions[currentQuestionIndex];
  document.querySelectorAll(".quiz-option").forEach(b=>b.style.pointerEvents="none");

  if(idx===q.a){
    currentScore++;
    currentStreak++;
    document.getElementById(`opt-${idx}`).classList.add("correct");
    document.getElementById("quizFeedback").innerText = "✅ Correct!";
    document.getElementById("quizFeedback").style.color="#00c864";
    playQuizCorrect();
    if(currentStreak===5){
      localStorage.setItem("streakBadge","earned");
      showToast("🔥 On Fire! 5-answer streak badge earned!","success");
    }
  }else{
    currentStreak=0;
    document.getElementById(`opt-${idx}`).classList.add("wrong");
    document.getElementById(`opt-${q.a}`).classList.add("correct");
    document.getElementById("quizFeedback").innerText = "❌ Wrong! Correct answer: " + q.o[q.a];
    document.getElementById("quizFeedback").style.color="#ff5c5c";
    playQuizWrong();
  }

  document.getElementById("quizScoreDisplay").innerText="Score: "+currentScore;
  updateStreakDisplay();
  document.getElementById("quizNextBtn").classList.remove("hidden");
}

function nextQuestion(){
  currentQuestionIndex++;
  if(currentQuestionIndex>=currentQuestions.length){
    endQuiz();
  }else{
    renderQuestion();
  }
}

async function endQuiz(){
  stopQuizTimer();
  const total=currentQuestions.length;
  const pct=Math.round((currentScore/total)*100);

  let emoji,title,msg;
  if(pct>=90){ emoji="🏆"; title="Outstanding!"; msg="Perfect performance! You are a champion."; }
  else if(pct>=70){ emoji="🌟"; title="Excellent!"; msg="Great job! You really know your stuff."; }
  else if(pct>=50){ emoji="😊"; title="Good Job!"; msg="Well done! Keep studying to do even better."; }
  else if(pct>=30){ emoji="📚"; title="Keep Going!"; msg="Not bad, but there's room to improve."; }
  else{ emoji="💪"; title="Don't Give Up!"; msg="Keep practicing — everyone starts somewhere!"; }

  document.getElementById("quizResultEmoji").innerText=emoji;
  document.getElementById("quizResultTitle").innerText=title;
  document.getElementById("quizResultMsg").innerText=msg;
  document.getElementById("quizFinalScore").innerText=`${currentScore} / ${total}  (${pct}%)`;

  const bestKey = "quizBest_"+currentLevel+"_"+currentSubject;
  const prevBest = parseInt(localStorage.getItem(bestKey)||"0");
  let bestMsg="";
  if(pct>prevBest){
    localStorage.setItem(bestKey, pct);
    localStorage.setItem("quizBest", pct+"%  — "+currentSubject);
    bestMsg = pct===100 ? "🎉 Perfect score!" : "⬆️ New personal best!";
  }else if(pct===prevBest){
    bestMsg = "Matched your best of "+prevBest+"%";
  }else{
    bestMsg = "Your best for this subject: "+prevBest+"%";
  }
  document.getElementById("quizBestMsg").innerText=bestMsg;

  showQuizStep("quizResult");
  localStorage.setItem("quizCompletedBadge","earned");

  const user = window.auth.currentUser;
  if(user){
    const name=localStorage.getItem("studentName")||"Student";
    try{
      await window.addDoc(window.collection(window.db,"quizScores"),{
        uid:user.uid, name, level:currentLevel, subject:currentSubject,
        score:currentScore, total, pct, createdAt:new Date()
      });
    }catch(e){ console.log("Score save error:",e); }
  }
}

function replayQuiz(){ selectSubject(currentSubject); }

async function showLeaderboard(){
  document.getElementById("leaderboardSubjectLabel").innerText =
    QUIZ_DATA[currentLevel].label + " — " + currentSubject;
  document.getElementById("leaderboardList").innerHTML="<p style='opacity:.6;'>Loading...</p>";
  showQuizStep("quizLeaderboard");
  try{
    const q = window.query(
      window.collection(window.db,"quizScores"),
      window.where("level","==",currentLevel),
      window.where("subject","==",currentSubject),
      window.orderBy("pct","desc"),
      window.limit(20)
    );
    const snap = await window.getDocs(q);
    if(snap.empty){ document.getElementById("leaderboardList").innerHTML="<p style='opacity:.6;'>No scores yet. Be the first!</p>"; return; }
    let html="", rank=0;
    snap.forEach(d=>{
      rank++;
      const data=d.data();
      const rowClass=rank===1?"top1":rank===2?"top2":rank===3?"top3":"";
      const medal=rank===1?"🥇":rank===2?"🥈":rank===3?"🥉":"#"+rank;
      html+=`<div class="leaderboard-row ${rowClass}">
        <span>${medal} ${escapeHtml(data.name)}</span>
        <span style="font-weight:bold;color:#ffd700;">${data.score}/${data.total} (${data.pct}%)</span>
      </div>`;
    });
    document.getElementById("leaderboardList").innerHTML=html;
  }catch(e){
    document.getElementById("leaderboardList").innerHTML="<p style='color:#ff5c5c;'>Could not load leaderboard.</p>";
  }
}

function showResultFromLeaderboard(){ showQuizStep("quizResult"); }
function exitQuiz(){ stopQuizTimer(); backToDashboard(); }


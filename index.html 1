<div id="notesSection" class="card hidden">
<h2>My Notes</h2>
<textarea id="noteText" oninput="updateCharCount()" placeholder="Write your notes here..." style="width:100%;height:200px;padding:15px;border-radius:10px;margin-top:15px;"></textarea>
<p>Characters: <span id="charCount">0</span> &nbsp;|&nbsp; Words: <span id="wordCount">0</span></p>

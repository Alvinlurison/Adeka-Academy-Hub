<input id="meetingCode" placeholder="Enter a Room Name (e.g. math-class-1)">
<button onclick="joinMeeting()">Start / Join Meeting</button>
<button class="btn-danger hidden" onclick="leaveMeeting()" id="leaveMeetingBtn">Leave Meeting</button>

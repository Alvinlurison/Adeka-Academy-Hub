<h3 style="margin-top:20px;">Saved Notes (<span id="noteCount">0</span>)
<p style="font-size:13px;font-weight:normal;opacity:.7;">Maximum Notes Recommended: 100</p>
</h3>
<div id="savedNotes"></div>
</div>

<div id="aiTutorSection" class="card hidden">
<h2>Adeka AI Tutor</h2>
<input id="userQuestion" placeholder="Ask a question...">

function saveProfilePicture(event){
  const file = event.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  const alreadyEarned = !!localStorage.getItem("profileBadge");
  reader.onload = function(e){
    document.getElementById("profileImage").src = e.target.result;
    localStorage.setItem("profilePicture", e.target.result);
    document.getElementById("profileStatus").innerText = "Yes";
    localStorage.setItem("profileBadge","earned");
    if(!alreadyEarned){ playBadgeSound(); showToast("📸 Profile Master badge earned!","success"); }
    showToast("Profile picture updated!","info");
  };
  reader.readAsDataURL(file);
}

function clearDraft(){
  localStorage.removeItem("draftNote");
  document.getElementById("noteText").value = "";

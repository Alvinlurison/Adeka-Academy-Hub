<button onclick="joinAudioRoom()">Start / Join Audio Room</button>
<button class="btn-danger hidden" onclick="leaveAudioRoom()" id="leaveAudioBtn">Leave Audio Room</button>
<div id="jitsiAudioContainer" class="callContainer hidden"></div>
